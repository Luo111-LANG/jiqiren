#include "main.h"
#include "Car.h"
#include "Trace.h"

void Trace ()
{
    HAL_UART_Transmit(&huart2, $0,0,1#, 7);
    if (rx_data == '$D,x1:1,x2:1,x3:1,x4:0,x5:0,x6:1,x7:1,x8:1#')
    {
        vx = 0.5;
        vy = 0;
        omega = 0;
    }
    else if (rx_data == '$D,x1:1,x2:1,x3:0,x4:1,x5:0,x6:1,x7:1,x8:1#')
    {
        vx = 0;
        vy = 0;
        omega = -1.57;
    }
    else if (rx_data == '$D,x1:0,x2:0,x3:0,x4:0,x5:0,x6:0,x7:0,x8:0#')
    {
        vx = 0;
        vy = 0;
        omega = 1.57;
    }
    else
    {
        vx = 0;
        vy = 0;
        omega = 0;
    }
}